[Unit]
Description=Archive GitHub credential broker audit events off-host
Documentation=https://github.com/cesaregarza/github-credential-broker

[Service]
Type=oneshot
EnvironmentFile=/etc/github-credential-broker-audit-monitor.env
ExecStart=/usr/local/bin/github-credential-broker-audit-monitor \
  --ssh-target ${BROKER_AUDIT_SSH_TARGET} \
  --archive-dir ${BROKER_AUDIT_ARCHIVE_DIR} \
  --state-file ${BROKER_AUDIT_STATE_FILE} \
  --health-url ${BROKER_AUDIT_HEALTH_URL} \
  --denial-threshold ${BROKER_AUDIT_DENIAL_THRESHOLD} \
  --health-failure-threshold ${BROKER_AUDIT_HEALTH_FAILURE_THRESHOLD}
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/backups/github-credential-broker/audit /var/lib/github-credential-broker-audit-monitor
